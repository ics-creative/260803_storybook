{
  "name": "260803-storybook",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "demos/*"
  ],
  "scripts": {
    "dev": "npm run dev -w notice-list",
    "storybook": "npm run storybook -w notice-list",
    "storybook:patterns": "npm run storybook -w patterns",
    "build": "npm run build:clean && npm run build -w notice-list && npm run build -w patterns && npm run build:landing",
    "build:clean": "rm -rf dist",
    "build:landing": "node scripts/copy-landing.mjs",
    "lint": "oxlint demos"
  },
  "devDependencies": {
    "oxlint": "^1.71.0"
  }
}
